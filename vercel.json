{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "hnp1.vercel.app" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    { "source": "/policies/privacy-policy", "destination": "/privacy-policy.html", "permanent": true },
    { "source": "/policies/refund-policy", "destination": "/refund-policy.html", "permanent": true },
    { "source": "/policies/shipping-policy", "destination": "/shipping-policy.html", "permanent": true },
    { "source": "/policies/terms-of-service", "destination": "/terms-of-service.html", "permanent": true },
    { "source": "/policies/legal-notice", "destination": "/legal-notice.html", "permanent": true },
    { "source": "/policies/contact-information", "destination": "/contact.html", "permanent": true },
    { "source": "/pages/data-sharing-opt-out", "destination": "/data-sharing-opt-out.html", "permanent": true },
    {
      "source": "/account",
      "destination": "https://j1rk0j-9d.myshopify.com/account",
      "permanent": false
    },
    {
      "source": "/account/:path*",
      "destination": "https://j1rk0j-9d.myshopify.com/account/:path*",
      "permanent": false
    },
    {
      "source": "/products/:path+",
      "destination": "https://j1rk0j-9d.myshopify.com/products/:path+",
      "permanent": false
    },
    {
      "source": "/cart",
      "destination": "https://j1rk0j-9d.myshopify.com/cart",
      "permanent": false
    },
    {
      "source": "/cart/:path*",
      "destination": "https://j1rk0j-9d.myshopify.com/cart/:path*",
      "permanent": false
    }
  ]
}
